{
  "expo": {
    "name": "Anything But a Game Controller",
    "slug": "anything-but-a-game-controller",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.anythingbutagamecontroller.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    }
  }
}
